# ── CodeLens Frontend Environment Variables ────────────────────────────────
# API Server URL (leave empty or use http://localhost:3001 in local dev)
VITE_API_URL=http://localhost:3001

# Supabase Auth & Database (Public Anon Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ImageKit Public Key (Client-side avatar uploads)
VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
