PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── AI Provider Settings (Free Tiers Supported) ──────────────────────────────
# CodeLens uses a smart fallback chain: Groq -> Gemini -> OpenAI-Compatible -> Generic LLM

# 1. Groq Cloud (Recommended: Ultra-fast & Free tier available at https://console.groq.com)
GROQ_API_KEY=
# Supported free models (automatically tries next if one is rate limited or unavailable):
# llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it, llama-3.2-11b-vision-preview, llama-3.2-3b-preview, llama3-70b-8192, llama3-8b-8192, qwen/qwen3.8-27b
GROQ_MODEL=llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it, llama-3.2-11b-vision-preview, llama-3.2-3b-preview, llama3-70b-8192, llama3-8b-8192, qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# 2. Google Gemini (Free tier available via Google AI Studio at https://aistudio.google.com)
GEMINI_API_KEY=
# Supported free models (automatically tries next if one is overloaded or rate limited):
# gemini-2.0-flash, gemini-2.0-flash-exp, gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.5-pro, gemini-flash-latest
GEMINI_MODEL=gemini-2.0-flash, gemini-2.0-flash-exp, gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.5-pro, gemini-flash-latest

# 3. OpenAI-Compatible (OpenRouter free models, LM Studio, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# 4. Generic LLM / Enterprise Provider (Optional)
LLM_API_KEY=
LLM_PROJECT_ID=
LLM_API_URL=
LLM_MODEL_ID=

# AI Tuning
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# ── ImageKit (Image CDN & Asset Storage - https://imagekit.io) ─────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Supabase (Database, Auth & Rate Limiting - https://supabase.com) ─────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Upload Limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
