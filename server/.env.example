PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── AI Provider Settings (Free Tiers Supported) ──────────────────────────────
# CodeLens uses a smart fallback chain: Groq -> Gemini -> OpenAI-Compatible -> Generic LLM

# 1. Groq Cloud (Recommended: Ultra-fast & Free tier available at https://console.groq.com)
GROQ_API_KEY=
# Supported free models:
# - llama-3.1-8b-instant (Fastest, default, recommended for general code intelligence)
# - llama-3.3-70b-versatile (Highest reasoning capability on free tier)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# 2. Google Gemini (Free tier available via Google AI Studio at https://aistudio.google.com)
GEMINI_API_KEY=
# Supported free models:
# - gemini-1.5-flash (Fast and generous context window)
# - gemini-2.0-flash (Next-gen speed and multimodal support)
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenAI-Compatible (OpenRouter free models, LM Studio, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# 4. Generic LLM / Enterprise Provider (Optional)
LLM_API_KEY=
LLM_PROJECT_ID=
LLM_API_URL=
LLM_MODEL_ID=

# AI Tuning
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# ── ImageKit (Image CDN & Asset Storage - https://imagekit.io) ─────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Supabase (Database, Auth & Rate Limiting - https://supabase.com) ─────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Upload Limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
